{
  "name": "@ameme/inference-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/gateway.test.ts test/openai-provider.test.ts test/server.test.ts test/openai-live.test.ts",
    "check": "npm run typecheck && npm test",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "openai": "6.46.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
